table gold_axe_reservations
	lineageTag: 0a424e9b-6d2b-437e-a9d4-d55a578b07f8
	sourceLineageTag: [dbo].[gold_axe_reservations]

	measure 'Amortissement mensuel' = DIVIDE(SELECTEDVALUE(gold_saisie_investissement[valeur]), SELECTEDVALUE(gold_saisie_duree_amortissement[valeur]) * 12)
		formatString: #,0 €
		lineageTag: d25bc5ed-bdd8-4df7-a0f2-dc1917d311c9

	measure 'Charges fixes mensuelles' = IF(ISBLANK(SELECTEDVALUE(gold_saisie_vehicules[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_investissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_duree_amortissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_station[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_vehicule[valeur])), BLANK(), SELECTEDVALUE(gold_saisie_charges_station[valeur]) + SELECTEDVALUE(gold_saisie_vehicules[valeur]) * SELECTEDVALUE(gold_saisie_charges_vehicule[valeur]) + [Amortissement mensuel])
		formatString: #,0 €
		lineageTag: c57f4d06-de51-46d6-9f44-835947c431ac

	measure 'Marge par réservation' = IF(ISBLANK(SELECTEDVALUE(gold_saisie_recette_reservation[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_cout_variable_reservation[valeur])), BLANK(), SELECTEDVALUE(gold_saisie_recette_reservation[valeur]) - SELECTEDVALUE(gold_saisie_cout_variable_reservation[valeur]))
		formatString: #,0.00 €
		lineageTag: 86b3adc7-0fed-41cc-bfd4-8abc8eecb1d4

	measure 'Seuil réservations par mois' = IF([Marge par réservation] > 0, DIVIDE([Charges fixes mensuelles], [Marge par réservation]))
		formatString: #,0
		lineageTag: f4da4d7c-9050-4c6e-82b8-44d7de8e4e28

	measure 'Seuil réservations par véhicule' = DIVIDE([Seuil réservations par mois], SELECTEDVALUE(gold_saisie_vehicules[valeur]))
		formatString: #,0.0
		lineageTag: 7eff55b9-3d38-48f2-a758-002348c0b9e0

	measure 'Réservations prévues par mois' = SELECTEDVALUE(gold_saisie_vehicules[valeur]) * SELECTEDVALUE(gold_saisie_reservations_vehicule[valeur])
		formatString: #,0
		lineageTag: 7f55cae0-065d-4249-bd2d-6cb40dccec65

	measure 'Résultat mensuel prévu' = IF(ISBLANK(SELECTEDVALUE(gold_saisie_vehicules[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_investissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_duree_amortissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_station[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_vehicule[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_recette_reservation[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_cout_variable_reservation[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_reservations_vehicule[valeur])), BLANK(), [Réservations prévues par mois] * [Marge par réservation] - [Charges fixes mensuelles])
		formatString: #,0 €
		lineageTag: ea6e6b0d-3c12-42d1-b837-eb8ce1818620

	measure 'Couverture du seuil' = DIVIDE([Réservations prévues par mois], [Seuil réservations par mois])
		formatString: 0%
		lineageTag: 3b247dff-cb82-40c6-bca4-65af00e254fb

	measure Verdict = IF(ISBLANK(SELECTEDVALUE(gold_saisie_vehicules[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_investissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_duree_amortissement[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_station[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_charges_vehicule[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_recette_reservation[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_cout_variable_reservation[valeur])) || ISBLANK(SELECTEDVALUE(gold_saisie_reservations_vehicule[valeur])), "À renseigner", IF([Marge par réservation] <= 0, "Marge négative", IF([Résultat mensuel prévu] >= 0, "Rentable", "Non rentable")))
		lineageTag: 0536675c-6062-47d8-8b72-913235e3d02f

	measure 'Résultat selon réservations' = VAR x = MAX(gold_axe_reservations[reservations_vehicule]) RETURN IF(ISBLANK([Charges fixes mensuelles]) || ISBLANK([Marge par réservation]), BLANK(), SELECTEDVALUE(gold_saisie_vehicules[valeur]) * x * [Marge par réservation] - [Charges fixes mensuelles])
		formatString: #,0 €
		lineageTag: db1f1692-2be9-478c-8a38-f1910d8be00f

	column reservations_vehicule
		dataType: int64
		lineageTag: ba0e8d73-6b82-4ea3-8f48-d4c06cd09d4b
		sourceLineageTag: reservations_vehicule
		summarizeBy: none
		sourceColumn: reservations_vehicule

		annotation SummarizationSetBy = Automatic

	partition gold_axe_reservations = entity
		mode: directLake
		source
			entityName: gold_axe_reservations
			schemaName: dbo
			expressionSource: 'DirectLake - Gold'
