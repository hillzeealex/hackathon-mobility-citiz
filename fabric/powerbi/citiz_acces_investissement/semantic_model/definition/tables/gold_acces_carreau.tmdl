table gold_acces_carreau
	lineageTag: 90d8d651-71b9-4dae-91fd-54bf0d71825e
	sourceLineageTag: [dbo].[gold_acces_carreau]

	measure Habitants = SUM(gold_acces_carreau[pop_calee])
		formatString: #,0
		lineageTag: 24b73462-655f-4c3e-9520-2a4d271e76ac

	measure 'Options par habitant' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[options_ponderees]), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0
		lineageTag: e0adce93-85f0-4d0c-84e8-b172fae0fe7a

	measure 'Part sans option' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[sans_option] = TRUE()), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0%
		lineageTag: 33c96255-06e4-4dc3-bfa2-ed818ab08fae

	measure 'Part à 5 min TC' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_tc] = TRUE()), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0%
		lineageTag: b170a930-d380-4b76-99df-dc9d92416925

	measure 'Part à 5 min Citiz' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_citiz] = TRUE()), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0%
		lineageTag: 5ee2f262-89d7-49d7-addb-15b1294e1d63

	measure 'Part à 5 min autopartage' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_autopartage] = TRUE()), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0%
		lineageTag: ff443751-db97-4ad5-9839-31caf1f65c9d

	measure 'Part à 5 min vélo' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_velo] = TRUE()), SUM(gold_acces_carreau[pop_calee]))
		formatString: 0.0%
		lineageTag: f35986fb-1d67-4d8d-bc0e-042d413877b3

	measure 'Options par habitant (marche)' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[options_v2]), SUMX(gold_acces_carreau, IF(ISBLANK(gold_acces_carreau[options_v2]), 0, gold_acces_carreau[pop_calee])))
		formatString: 0.0
		lineageTag: 5c787f38-33df-4684-a3c6-26440bd86ef8

	measure 'Part sans option (marche)' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[sans_option_v2] = TRUE()), CALCULATE(SUM(gold_acces_carreau[pop_calee]), NOT ISBLANK(gold_acces_carreau[sans_option_v2])))
		formatString: 0.0%
		lineageTag: 3c6a8065-cfa9-4ec1-bd4f-80ad15ae91af

	measure 'Part à 5 min TC (marche)' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_tc_v2] = TRUE()), CALCULATE(SUM(gold_acces_carreau[pop_calee]), NOT ISBLANK(gold_acces_carreau[couvert_tc_v2])))
		formatString: 0.0%
		lineageTag: 6fe3d95f-fc8f-4744-a9ca-a43a45d97e80

	measure 'Part à 5 min Citiz (marche)' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_citiz_v2] = TRUE()), CALCULATE(SUM(gold_acces_carreau[pop_calee]), NOT ISBLANK(gold_acces_carreau[couvert_citiz_v2])))
		formatString: 0.0%
		lineageTag: a2c64fad-aa05-4359-8a6e-ec159acb74da

	measure 'Part à 5 min autopartage (marche)' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_autopartage_v2] = TRUE()), CALCULATE(SUM(gold_acces_carreau[pop_calee]), NOT ISBLANK(gold_acces_carreau[couvert_autopartage_v2])))
		formatString: 0.0%
		lineageTag: 67340bc6-3c55-43dc-850d-906226a8cb77

	measure 'Part à 5 min vélo (marche)' = DIVIDE(CALCULATE(SUM(gold_acces_carreau[pop_calee]), gold_acces_carreau[couvert_velo_v2] = TRUE()), CALCULATE(SUM(gold_acces_carreau[pop_calee]), NOT ISBLANK(gold_acces_carreau[couvert_velo_v2])))
		formatString: 0.0%
		lineageTag: 2ee1baa2-c533-424c-bfd2-87f2788022df

	measure 'Niveau de vie moyen' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[niveau_vie_moyen]), SUMX(gold_acces_carreau, IF(ISBLANK(gold_acces_carreau[niveau_vie_moyen]), 0, gold_acces_carreau[pop_calee])))
		formatString: #,0 €
		lineageTag: b99286bc-9fe1-4a92-92ad-7a3ab9be2b6c

	measure 'Part de ménages pauvres' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[part_menages_pauvres]), SUMX(gold_acces_carreau, IF(ISBLANK(gold_acces_carreau[part_menages_pauvres]), 0, gold_acces_carreau[pop_calee])))
		formatString: 0.0%
		lineageTag: 1963fac3-b634-4aaf-af58-b4cc34338f6b

	measure 'Part des 18-24 ans' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[part_18_24]), SUMX(gold_acces_carreau, IF(ISBLANK(gold_acces_carreau[part_18_24]), 0, gold_acces_carreau[pop_calee])))
		formatString: 0.0%
		lineageTag: 5a826571-34da-436f-a85c-78707fff0d8c

	measure 'Part des 65 ans et plus' = DIVIDE(SUMX(gold_acces_carreau, gold_acces_carreau[pop_calee] * gold_acces_carreau[part_65_plus]), SUMX(gold_acces_carreau, IF(ISBLANK(gold_acces_carreau[part_65_plus]), 0, gold_acces_carreau[pop_calee])))
		formatString: 0.0%
		lineageTag: 0f7e85c8-8903-4e0c-83f7-7f9430a8ba31

