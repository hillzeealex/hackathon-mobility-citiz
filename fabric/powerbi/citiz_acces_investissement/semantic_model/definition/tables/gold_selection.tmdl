table gold_selection
	lineageTag: baf12801-02e7-4aab-85ec-021a013e3971
	sourceLineageTag: [dbo].[gold_selection]

	measure Horizon = SELECTEDVALUE(gold_horizons[horizon_ans], 0)
		formatString: 0" ans"
		lineageTag: d9351eb6-d7d4-4fbc-8436-adcfde4d669e

	measure 'Habitants gagnés horizon' = VAR h = [Horizon] RETURN SUMX(gold_selection, gold_selection[pop_nouvellement_desservie] * COALESCE(LOOKUPVALUE(gold_projection_commune[facteur], gold_projection_commune[commune_code], gold_selection[commune_code], gold_projection_commune[horizon_ans], h), 1))
		formatString: #,0
		lineageTag: bf26f5f0-2d04-452c-83d7-8a603fbf1f7d

	measure 'Coût par habitant horizon' = DIVIDE([Coût total], [Habitants gagnés horizon])
		formatString: #,0.0 €
		lineageTag: ec99ecfc-cc93-46c3-a3b7-7ba38d37af4d

	measure 'Part 65 ans et plus Loire-Atlantique' = LOOKUPVALUE(gold_age_departement[part_65_plus], gold_age_departement[code_dept], "44", gold_age_departement[horizon_ans], [Horizon])
		formatString: 0.0%
		lineageTag: 30805eae-b50c-451d-b654-073cfa073677

	measure Emplacements = COUNTROWS(gold_selection)
		formatString: #,0
		lineageTag: 8b085295-44d6-401f-a80c-7137d605fe4a

	measure 'Coût total' = SUM(gold_selection[cout])
		formatString: #,0 €
		lineageTag: f7bd4fd5-2dc7-4c6a-ab01-5ce155b77b0d

	measure 'Habitants nouvellement desservis' = SUM(gold_selection[pop_nouvellement_desservie])
		formatString: #,0
		lineageTag: d4351168-f05a-4677-9910-53e70abdfebf

	measure 'Coût par habitant' = DIVIDE([Coût total], [Habitants nouvellement desservis])
		formatString: #,0.0 €
		lineageTag: 3bfb6665-c868-495b-ad68-750a003582c4

	measure 'CO2 évité (t par an)' = SUM(gold_selection[co2_evite_t_an])
		formatString: #,0.0
		lineageTag: 061762d4-4702-4003-82d9-926d00624171

